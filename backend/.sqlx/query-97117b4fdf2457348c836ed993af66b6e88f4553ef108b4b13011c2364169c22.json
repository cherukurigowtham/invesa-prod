  "query": "\n        SELECT i.id AS idea_id, i.title AS name, i.created_at AS last_message_time\n        FROM ideas i\n        JOIN team_members tm ON i.id = tm.idea_id\n        WHERE tm.user_id = $1\n        ORDER BY i.created_at DESC\n        ",
