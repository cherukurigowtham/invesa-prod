{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT jr.id, jr.idea_id, jr.builder_id, jr.message, jr.status, jr.created_at, i.title as idea_title\n            FROM join_requests jr\n            JOIN ideas i ON jr.idea_id = i.id\n            WHERE jr.builder_id = $1\n            ORDER BY jr.created_at DESC\n            ",
