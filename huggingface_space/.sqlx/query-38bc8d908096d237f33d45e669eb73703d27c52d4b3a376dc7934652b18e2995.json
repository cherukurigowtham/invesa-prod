  "query": "\n        SELECT ii.id, ii.idea_id, ii.investor_id, u.name as investor_name, ii.note, ii.created_at\n        FROM investor_interests ii\n        JOIN users u ON ii.investor_id = u.id\n        WHERE ii.idea_id = $1\n        ",
